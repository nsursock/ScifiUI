{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["vite/client"],
    "target": "ES2022",
    "useDefineForClassFields": false,
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.ts"]
}
