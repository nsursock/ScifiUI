{
  "name": "scifiui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @scifiui/docs dev",
    "dev:docs": "pnpm --filter @scifiui/docs dev",
    "dev:landing": "pnpm --filter @scifiui/template-landing dev",
    "dev:dashboard": "pnpm --filter @scifiui/template-dashboard dev",
    "dev:auth": "pnpm --filter @scifiui/template-auth dev",
    "build": "pnpm -r build",
    "build:core": "pnpm --filter @scifiui/core build",
    "dev:ide": "pnpm --filter @scifiui/template-ide dev",
    "dev:react": "pnpm --filter @scifiui/demo-react dev",
    "dev:vue": "pnpm --filter @scifiui/demo-vue dev",
    "dev:svelte": "pnpm --filter @scifiui/demo-svelte dev",
    "dev:angular": "pnpm --filter @scifiui/demo-angular dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
